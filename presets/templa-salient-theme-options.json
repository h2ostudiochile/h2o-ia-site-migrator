{
  "preset_id": "templa-design-salient-visual-v1",
  "site": "templadesign.cl",
  "target": "Salient Theme Options",
  "mode": "operator_preset_only",
  "architecture": {
    "runtime_theme_mutation": false,
    "note": "El Site Migrator no escribe salient_redux ni internals del tema. Este preset se aplica como configuración administrativa de Salient por un operador/conector autorizado."
  },
  "design_intent": "Minimalista, editorial, arquitectura/interiorismo, Apple/Shopify",
  "palette": {
    "accent_color": "#FFC300",
    "extra_color_1": "#2E2B24",
    "extra_color_2": "#FDFAF3",
    "extra_color_3": null,
    "gradient_1": null,
    "gradient_2": null,
    "overall_font_color": "#2E2B24"
  },
  "header_navigation": {
    "logo_height": 62,
    "mobile_logo_height": 42,
    "header_padding": 18,
    "menu_item_spacing": 16,
    "header_box_shadow": "none",
    "header_hover_effect": {
      "value": "default",
      "label": "Color Change",
      "forbidden_values": [
        "animated_underline"
      ],
      "alternatives_allowed": [
        "button_bg",
        "text_reveal"
      ]
    }
  },
  "font_loading": {
    "family": "Manrope",
    "default_theme_font_functionality": "remove",
    "load_google_fonts_locally": true,
    "weights": [
      400,
      500,
      600,
      700
    ],
    "italic_weights": [
      400
    ]
  },
  "typography": {
    "navigation_page_header": {
      "logo_font_family": {
        "family": "Manrope",
        "weight": 600,
        "size": "1rem",
        "line_height": "1",
        "letter_spacing": "-0.01em",
        "transform": "none"
      },
      "navigation_font_family": {
        "family": "Manrope",
        "weight": 500,
        "size": "0.925rem",
        "line_height": "1",
        "letter_spacing": "0.015em",
        "transform": "none"
      },
      "navigation_dropdown_font_family": {
        "family": "Manrope",
        "weight": 500,
        "size": "0.875rem",
        "line_height": "1.4",
        "letter_spacing": "0.01em",
        "transform": "none"
      },
      "page_heading_font_family": {
        "family": "Manrope",
        "weight": 600,
        "size": "4rem",
        "line_height": "1.05",
        "letter_spacing": "-0.04em",
        "transform": "none"
      },
      "page_heading_subtitle_font_family": {
        "family": "Manrope",
        "weight": 400,
        "size": "1.125rem",
        "line_height": "1.5",
        "letter_spacing": "-0.01em",
        "transform": "none"
      },
      "off_canvas_nav_font_family": {
        "family": "Manrope",
        "weight": 500,
        "size": "2.75rem",
        "line_height": "1.05",
        "letter_spacing": "-0.035em",
        "transform": "none"
      },
      "off_canvas_nav_subtext_font_family": {
        "family": "Manrope",
        "weight": 400,
