    },
    "responsive_settings": {
      "strategy": "fluid_typography",
      "desktop": {
        "min": "1rem",
        "max": "1.08rem",
        "custom": "calc(0.45vw + 0.55rem)"
      },
      "mobile": {
        "min": "1rem",
        "max": "1.05rem",
        "custom": "calc(0.3vw + 0.94rem)"
      },
      "legacy_breakpoint_fallback": {
        "h1": [
          85,
          72,
          60
        ],
        "h2": [
          90,
          80,
          68
        ],
        "h3": [
          95,
          85,
          75
        ],
        "h4": [
          100,
          90,
          85
        ],
        "h5": [
          100,
          95,
          95
        ],
        "h6": [
          100,
          100,
          100
        ],
        "body": [
          100,
          100,
          100
        ],
        "blockquote": [
          95,
          90,
          85
        ]
      }
    },
    "spacing": {
      "heading_bottom_spacing": "0.55em",
      "paragraph_bottom_spacing": "1.25em"
    }
  },
  "constraints": [
    "Never use Animated Underline",
    "Do not add CSS to simulate Theme Options",
    "Do not hardcode body font size in WPBakery content",
    "Do not write salient_redux from Site Migrator runtime"
  ]
}
