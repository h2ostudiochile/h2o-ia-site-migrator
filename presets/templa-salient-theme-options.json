  "responsive_settings": {
    "use_custom_responsive_headings": true,
    "h1": {
      "small_desktop": 85,
      "tablet": 72,
      "phone": 60
    },
    "h2": {
      "small_desktop": 90,
      "tablet": 80,
      "phone": 68
    },
    "h3": {
      "small_desktop": 95,
      "tablet": 85,
      "phone": 75
    },
    "h4": {
      "small_desktop": 100,
      "tablet": 90,
      "phone": 85
    },
    "h5": {
      "small_desktop": 100,
      "tablet": 95,
      "phone": 95
    },
    "h6": {
      "small_desktop": 100,
      "tablet": 100,
      "phone": 100
    },
    "body": {
      "small_desktop": 100,
      "tablet": 100,
      "phone": 100
    },
    "blockquote": {
      "small_desktop": 95,
      "tablet": 90,
      "phone": 85
    }
  },
  "spacing": {
    "heading_bottom_spacing": "0.55em",
    "paragraph_bottom_spacing": "1.25em"
  },
  "constraints": [
    "Never use Animated Underline",
    "Do not add CSS to simulate Theme Options",
    "Do not hardcode body font size in WPBakery content",
    "Do not call get_option/update_option for salient_redux",
    "Apply once and never overwrite later manual edits"
  ]
}
