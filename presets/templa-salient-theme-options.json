{
  "preset_id": "templa-design-salient-visual-v2",
  "version": "1.0.17",
  "site": "templadesign.cl",
  "target": "Salient Theme Options",
  "mode": "one_time_apply_via_public_redux_api",
  "architecture": {
    "runtime_theme_mutation": true,
    "direct_salient_option_access": false,
    "public_api": "Redux::setOption / Redux::getOption",
    "one_time": true,
    "note": "El migrador configura el tema objetivo Salient mediante su API pública Redux. No lee/escribe salient_redux directamente y no toca otros componentes h2o."
  },
  "design_intent": "Minimalista, editorial, arquitectura/interiorismo, Apple/Shopify",
  "palette": {
    "accent_color": "#FFC300",
    "extra_color_1": "#2E2B24",
    "extra_color_2": "#FDFAF3",
    "overall_font_color": "#2E2B24"
  },
  "header_navigation": {
    "logo_height": 62,
    "mobile_logo_height": 42,
    "header_padding": 18,
    "menu_item_spacing": 16,
    "header_box_shadow": "none",
    "header_hover_effect": {
      "value": "default",
      "label": "Color Change",
      "forbidden_values": [
        "animated_underline"
      ],
      "alternatives_allowed": [
        "button_bg",
        "text_reveal"
      ]
    }
  },
  "font_loading": {
    "family": "Manrope",
    "default_theme_font_functionality": "remove",
    "load_google_fonts_locally": true,
    "weights": [
      "400",
      "500",
      "600",
      "700"
    ],
    "italic_weights": [
      "400italic"
    ]
  },
  "typography_styles": {
    "logo": {
      "family": "Manrope",
      "weight": "600",
      "size": "16px",
      "line_height": "16px",
      "letter_spacing": "0px",
      "transform": "none"
    },
    "navigation": {
      "family": "Manrope",
      "weight": "600",
